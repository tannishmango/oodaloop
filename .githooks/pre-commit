#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[oodaloop hook] pre-commit checks starting"

staged_files="$(git diff --cached --name-only)"

# 1) Prevent committing ephemeral runtime task files.
while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$file" in
    .oodaloop/*.task.md)
      echo "[oodaloop hook] ERROR: staged ephemeral task file: $file"
      exit 1
      ;;
  esac
done <<< "$staged_files"

# 2) Every command wrapper that invokes oodaloop:<skill> must resolve to a skill.
for command_file in commands/oodaloop-*.md; do
  [ -e "$command_file" ] || continue
  invoke_line="$(awk '/^Invoke the oodaloop:/ {print; exit}' "$command_file")"
  [ -z "$invoke_line" ] && continue

  skill_name="${invoke_line#*oodaloop:}"
  skill_name="${skill_name%% *}"
  skill_name="${skill_name%%\`*}"
  skill_name="${skill_name%%.*}"

  if [ ! -f "skills/$skill_name/SKILL.md" ]; then
    echo "[oodaloop hook] ERROR: missing skills/$skill_name/SKILL.md for $command_file"
    exit 1
  fi
done

# 3) Block accidental reintroduction of deprecated kickoff naming.
while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$file" in
    *.md|*.mdc|*.sh)
      staged_content="$(git show ":$file" 2>/dev/null || true)"
      case "$staged_content" in
        *"/oodaloop-begin"*|*"oodaloop-begin"*|*"oodaloop:begin"*|*"name: begin"*)
          echo "[oodaloop hook] ERROR: deprecated 'begin' kickoff naming found in staged file: $file"
          exit 1
          ;;
      esac
      ;;
  esac
done <<< "$staged_files"

# 4) Validate factual task-state invariants for valid fixture files.
# Semantic judgments (whether a surprise matters, whether a plan is good, whether
# work should rescope) intentionally do not belong in this hook.

_get_file_content() {
  local f="$1"
  local c
  c="$(git show ":$f" 2>/dev/null || true)"
  if [ -z "$c" ] && [ -f "$f" ]; then
    c="$(cat "$f")"
  fi
  printf '%s\n' "$c"
}

validate_task_file() {
  local file="$1"
  local content
  content="$(_get_file_content "$file")"
  [ -z "$content" ] && return 0

  local errors=0
  local phase_line phase
  phase_line="$(printf '%s\n' "$content" | grep -m1 '^## Phase:' || true)"
  phase="$(printf '%s\n' "$phase_line" | sed 's/^## Phase:[[:space:]]*//' | tr -d '[:space:]')"

  case "$phase" in
    observe|orient|decide|act|loop) ;;
    *)
      echo "[oodaloop hook] ERROR: $file: invalid phase '$phase' (expected observe|orient|decide|act|loop)"
      errors=$((errors + 1))
      ;;
  esac

  # Phase records the next phase to run, so require the evidence that made that
  # transition possible—not the output the next phase has not produced yet.
  local required=""
  case "$phase" in
    observe) required="## Objective" ;;
    orient)  required="## Observations" ;;
    decide)  required="## Assessment" ;;
    act)     required="## Plan" ;;
    loop)    required="## Execution" ;;
  esac

  if [ -n "$required" ] && ! printf '%s\n' "$content" | grep -q "^${required}$"; then
    echo "[oodaloop hook] ERROR: $file: phase '$phase' requires '$required'"
    errors=$((errors + 1))
  fi

  if printf '%s\n' "$content" | grep -q '^## Waiting$'; then
    local waiting
    waiting="$(printf '%s\n' "$content" | awk '/^## Waiting$/{found=1; next} found && /^## /{exit} found{print}')"
    for field in "Child" "Blocked leaf" "New evidence" "Resume at"; do
      if ! printf '%s\n' "$waiting" | grep -q "^${field}:"; then
        echo "[oodaloop hook] ERROR: $file: ## Waiting missing '$field:'"
        errors=$((errors + 1))
      fi
    done
  fi

  return $errors
}

# Parent cycles are factual corruption; depth itself is not an error.
walk_parent_chain() {
  local file="$1"
  local visited=""
  local current="$file"

  while true; do
    case "$visited" in
      *"|$current|"*)
        echo "[oodaloop hook] ERROR: $file: circular Parent: reference detected"
        return 1
        ;;
    esac
    visited="${visited}|${current}|"

    local content parent_line parent_slug parent_file
    content="$(_get_file_content "$current")"
    parent_line="$(printf '%s\n' "$content" | grep -m1 '^Parent:' || true)"
    [ -z "$parent_line" ] && return 0

    parent_slug="$(printf '%s\n' "$parent_line" | sed 's/^Parent:[[:space:]]*//' | tr -d '[:space:]')"
    [ -z "$parent_slug" ] && return 0

    parent_file="tests/fixtures/state-hygiene/${parent_slug}.task.md"
    if ! git show ":$parent_file" >/dev/null 2>&1 && [ ! -f "$parent_file" ]; then
      return 0
    fi
    current="$parent_file"
  done
}

fixture_errors=0
while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$file" in
    tests/fixtures/state-hygiene/valid*.task.md)
      validate_task_file "$file" || fixture_errors=$((fixture_errors + 1))
      walk_parent_chain "$file" || fixture_errors=$((fixture_errors + 1))
      ;;
  esac
done <<< "$staged_files"

if [ "$fixture_errors" -gt 0 ]; then
  exit 1
fi

echo "[oodaloop hook] pre-commit checks passed"
